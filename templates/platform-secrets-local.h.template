// The enrolment secret, and which server this build is for - the Arduino IDE form of
// platformio-secrets-local.ini. (PlatformIO users want that file instead, not this one.)
//
// TO USE (ESP32 boards): copy this file into your sketch folder, beside the .ino, named exactly
//     platform-secrets-local.h
// (no .template, and on Windows check it has not become .h.txt), then fill in the secret below.
// The library picks it up by itself - do not #include it from the sketch. It is in .gitignore:
// never commit it, and never paste the secret into a chat or an issue.
//
// ESP8266 boards cannot find this file. Put the same #define lines at the top of your
// <sketch>.ino.globals.h instead (see the example's esp8266/README.md).
//
// Without a secret the sketch still builds, but the node is refused when it first enrols: it
// shows as "Failed" on the dashboard's Nodes card, and an administrator has to approve it by hand.

// One per organization, from the dashboard: gear icon -> Nodes -> Enrolment secret. It grants
// exactly one thing, "create a node in this organization"; a node presents it once and then has
// its own credential.
#define SYSTEM_MQTT_ENROL_SECRET "paste-your-enrolment-secret-here"

// The public server needs nothing more. For your own server (a Raspberry Pi, say), uncomment and
// edit these. The organization and project must be ones that server knows.
//#define SYSTEM_FRUGAL_ORG "myorg"
//#define SYSTEM_FRUGAL_PROJECT "myproject"
//#define SYSTEM_MQTT_HOST "myserver.local"
//#define SYSTEM_MQTT_ENROL_URL "http://myserver.local:8080/enrol"   // http, not https, on a Pi
