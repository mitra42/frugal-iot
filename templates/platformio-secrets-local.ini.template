; The enrolment secret, and which server this build is for.
;
; TO USE: copy this file beside your platformio.ini, named exactly
;     platformio-secrets-local.ini
; (no .template, and on Windows check it has not become .ini.txt), then fill in the secret below.
; Every example's platformio.ini loads it through "extra_configs = *-local.ini". It is in
; .gitignore - never commit it, and never paste the secret into a chat or an issue.
;
; Without it the project still builds, but the node is refused when it first enrols: it shows as
; "Failed" on the dashboard's Nodes card, and an administrator has to approve it by hand.
;
; This file defines build_flags_secrets and nothing else; your own debug flags go in
; build_flags_local in platformio-local.ini. Keep each key in exactly ONE *-local.ini - a value is
; REPLACED, not merged, so defining one in both means whichever loads last silently wins.

[common]

build_flags_secrets =
    ; ---- The enrolment secret -------------------------------------------------------------
    ; One per organization, from the dashboard: gear icon -> Nodes -> Enrolment secret, which
    ; prints this line ready to paste over the one below. It grants exactly one thing, "create a
    ; node in this organization"; a node presents it once and then has its own credential.
    '-D SYSTEM_MQTT_ENROL_SECRET="paste-your-enrolment-secret-here"'
    ;
    ; ---- Which server ---------------------------------------------------------------------
    ; The public server needs nothing here: SYSTEM_MQTT_HOST and SYSTEM_MQTT_ENROL_URL already
    ; default to it. For your own server (a Raspberry Pi, say), uncomment and edit these. The
    ; organization and project must be ones that server knows - an unknown one is refused.
    ;'-D SYSTEM_FRUGAL_ORG="myorg"'
    ;'-D SYSTEM_FRUGAL_PROJECT="myproject"'
    ;'-D SYSTEM_MQTT_HOST="myserver.local"'
    ;'-D SYSTEM_MQTT_ENROL_URL="http://myserver.local:8080/enrol"' ; http, not https, on a Pi
